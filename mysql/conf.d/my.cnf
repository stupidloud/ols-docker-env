[mysqld]
# General settings
# 设置一个相对宽松的 SQL 模式，以提高兼容性
# 注意：这可能会降低严格性，请根据安全和数据完整性需求评估
sql_mode = "STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION"
max_connections = 150 # 根据预期流量调整
skip-name-resolve # 如果不需要 DNS 解析，可以取消注释以提高性能

# InnoDB settings (Assuming WordPress primarily uses InnoDB)
innodb_buffer_pool_size = 16G # **重要**: 根据服务器内存调整 (建议为总内存的 50-70%)
innodb_log_file_size = 4G    # 根据 buffer_pool_size 调整 (建议为其 25%)
innodb_flush_log_at_trx_commit = 2 # 性能优先，系统崩溃可能丢失少量事务，设为 1 最安全
innodb_flush_method = O_DIRECT # Linux 系统推荐
innodb_file_per_table = 1 # 推荐，每个表使用独立文件
innodb_ft_min_token_size = 1 # 允许索引更短的词元 (例如 MeCab 分词)

# MyISAM settings (For compatibility, though less used by modern WP)
key_buffer_size = 32M # 为 MyISAM 表索引分配缓存

# Query Cache (Deprecated in MySQL 8.0+, often causes contention)
# query_cache_type = 0 # 禁用查询缓存 (推荐)
# query_cache_size = 0 # 禁用查询缓存 (推荐)
# 如果使用旧版 MySQL 且网站读取密集，可以尝试启用:
# query_cache_type = 1
# query_cache_size = 64M
# query_cache_limit = 2M

# Temporary tables
tmp_table_size = 64M
max_heap_table_size = 64M

# Other settings
max_allowed_packet = 64M # 允许的最大数据包大小，对于导入/导出或大内容有用
thread_cache_size = 8 # 缓存的线程数
table_open_cache = 400 # 打开表的缓存数量